---
import "@styles/main.css";
import "@styles/global.css";
import { Font } from "astro:assets";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>AskExperts</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>

    <!-- filepath: src/layouts/Layout.astro -->
    <script src="../data/mobilemenu.js"></script>
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
