---
//@ts-nocheck

const response = await fetch("https://ftk-api.pages.dev/faq");
const faq = await response.json();

console.log(faq);
---
<section class="faq">
<p>FAQ</p>
<h1>Customer Questions</h1>
<div class="qa">
{faq.map((item) => (
  <>
  <button class="accordion">{item.question}</button>
  <div class="panel" >{item.answer}</div>
  </>)
) 
}  
</div>
</section>

<style>

.faq{
       display: flex;
       flex-direction: column;
margin-block: 5rem;
   grid-column: content;
   padding: 3rem;
   background: #0000;
   align-items: center;
   
}

  .accordion {
  color: var(--color-text); 
  cursor: pointer;
  padding: 18px;
  width: 100%;
  border: none;
  border-bottom: 1px solid var(--color-neutrals-400);
  text-align: left;
  outline: none;
  font-size: 15px;
  transition: 0.4s;
  &::after{
    content: "+"; 
 
  }
     .active&::after{
      content: "-"
    }
  display: flex;
  justify-content: space-between;

  }
.qa{
  inline-size: 100%;
max-width: 50%;
margin-inline: auto; 

}


.active, .accordion:hover {
  background-color: #ccc; 
}

.panel {
  margin-top: 1rem;
  color: var(--color-text-muted); 
  padding: 0 18px;
  display: none;
  background-color: #0000;
  overflow: hidden;
}
</style>

<script>
var acc = document.getElementsByClassName("accordion");
var i;

for (i = 0; i < acc.length; i++) {
  acc[i].addEventListener("click", function() {
    this.classList.toggle("active");
    var panel = this.nextElementSibling;
    if (panel.style.display === "block") {
      panel.style.display = "none";
    } else {
      panel.style.display = "block";
    }
  });
}
</script>