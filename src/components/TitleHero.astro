---
//@ts-nocheck

import { Headerinfo } from "../data/headerdata";
// const headerlink = Astro.url.pathname;
// const pageinfo = Headerinfo[headerlink];
// const {
//   underoverskrift = "",
//   headline = "",
//   description = "",
//   line = false,
// } = pageinfo || {};

const { variant } = Astro.props;

// 1. Hent stien og sørg for, at den altid er ens (f.eks. fjerner skråstreg til sidst)
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// 2. Slå op i jeres data ved at tjekke både med og uden skråstreg
const pageinfo =
  Headerinfo[currentPath] || Headerinfo[currentPath + "/"] || Headerinfo["/"];

// 3. Vores fejlsikre fallback (behold denne)
const {
  underoverskrift = "",
  headline = "",
  description = "",
  line = false,
} = pageinfo || {};
---

<div class="full-bleed titlehero">
  <p>{underoverskrift}</p>
  <h1 class:list={[line, "gul-linje"]}>{headline}</h1>
  <div></div>
  <p>{description}</p>
</div>

<style>
  .titlehero {
    text-align: center;

    padding: 6%;
    p {
      margin-top: 2rem;
      color: var(--color-text-muted);
      max-width: 64ch;
      margin-inline: auto;
    }
  }
  .full-bleed {
    background: var(--color-surface-secondary);
  }
</style>
