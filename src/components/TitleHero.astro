---
//@ts-nocheck


import {Headerinfo} from "../data/headerdata";
const headerlink = Astro.url.pathname; 
const pageinfo = Headerinfo[headerlink]; 
const {underoverskrift, headline, description } = pageinfo; 
---

<div class="full-bleed titlehero">
<p>{underoverskrift}</p>
<h1>{headline}</h1>
<div></div>
<p>{description}</p>
</div>



<style>

.titlehero{
text-align: center;

 padding: 6%;
 p{
    color: var(--color-text-muted);    
}
}
.full-bleed{
background:  var(--color-surface-secondary);
}

</style>