---
import { Image } from 'astro:assets';
import Ourvision from '../data/images/Ourvision.jpg';
//@ts-nocheck
import Checkmark from '../icons/checkmark.svg'; 
---

<section class="whattoexpect-layout">
    <div>
  <p class="brow">OUR VISION</p>
<h1>Turn your ideas into reality.</h1>
<p>
Capitalize on low hanging fruit to identify a ballpark value added activity beta test. 
Override the digital divide with additional from DevOps.
</p>
    <ul>
        <li><Checkmark style=" --accent: var(--color-ui-secondary)"/>Bring to the table win-win survival strategies to ensure proactive domination. At the end of the day.</li>
         <li><Checkmark style=" --accent: var(--color-ui-secondary)"/>Capitalize on low hanging fruit to identify a ballpark value added activity to beta test override the digital.</li>
    </ul>
      </div>
<figure>
<Image src= {Ourvision} alt="Menesker der snakke sammen i en gruppe"/>
</figure>
      </section>



      
  <style>

.whattoexpect-layout {
  margin-block: 5rem; 
        display: grid;
 grid-template-columns: 1fr 1fr ;
 grid-column: content;
padding: 15px;
  gap: 1rem;
  align-items: start;

}

.brow{
color: var(--color-text); 
}

p, li{
  color: var(--color-text-muted); 
}
p{
  max-inline-size: 50ch; 
}

svg{
  color:var(--accent);
  flex-shrink: 0;

}
ul{
    gap: 2rem;
    display: flex; /**overskriver en global regl */
    flex-direction: column;   /**overskriver en global regl */
    color: var(--color-text-weak);
    padding-left: 0%;
 
   li{
display: flex;
gap: 1rem;
align-items: center;
 max-inline-size: 45ch; 
    }
}


  figure {
  margin-inline: auto;
  margin: 3rem 1rem;
  display: block;

 img{
    border-radius: 15px; 
   
  display: block;
  inline-size: 100%;
  block-size: 100%;
  object-fit: cover;

  }
  


/**til start med^^ */

  position: relative;
  isolation: isolate; 
  
  &::before{
    content: "";
    position: absolute;
    top: -1rem;
    right: -1rem; 
    height: 100px;
    width: 100px;
    background: var(--color-ui-secondary);
    z-index: -1; 
    border-radius: 15px;
  }
}

@media (max-width: 400px){
  .whattoexpect-layout{ grid-template-columns: 1fr;}
  
}

</style>
