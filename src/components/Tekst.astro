---
//@ts-nocheck
const { eyebrow, title, subtitle } = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<section>
  {eyebrow && <p>{eyebrow}</p>}
  <h1>{title}</h1>
  <p class="lede">{subtitle}</p>
  {
    hasActions && (
      <div class="actions">
        <slot name="actions" />
      </div>
    )
  }
</section>

<style>
  h1 {
    padding-block: var(--under-h1-spacing);
  }
</style>
