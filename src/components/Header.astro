//@ts-nocheck
---

<section>
  <h1>Ask<span>Experts</span></h1>
  <ul>
    <li><a href="index.astro">Home</a></li>
    <li><a href="/src/pages/case-studies/index.astro">Case Studies</a></li>
    <li><a href="/src/pages/team/index.astro">Team</a></li>
    <li><a href="about.astro">About</a></li>
  </ul>
  <button>Login</button>
</section>

<style>
  section {
    background-color: var(--color-ui-primary);
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;

    ul {
      display: flex;
      gap: 2rem;

      li {
        list-style-type: none;
        border-bottom: #2c2b2b11;
        transition: border-bottom 1s ease;

        &:hover {
          /* text-decoration: underline var(--color-action) 3px; */
          border-bottom: var(--color-action) 3px solid;
        }
      }

      a {
        color: var(--color-surface-primary);
        text-decoration: none;
      }
    }

    h1 {
      color: #fff;
      span {
        color: var(--color-action);
      }
    }

    button {
      background: var(--color-surface-primary);
      border: none;
      border-radius: 30px;
      padding-inline: 1.5rem;
      padding-block: 0.5rem;
    }
  }
</style>
