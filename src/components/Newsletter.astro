---
import Knap from "../components/Button.astro";
import Tekst from "@components/Tekst.astro";
---

<div class="full-bleed">
  <section id="newsletter">
    <p class="Gulogstor">STAY UPDATED</p>
    <br />
    <Tekst title="Subscribe to Our Newsletter" />
    <p>Build stronger Customer Relationships with <b>Consultalk</b></p>

    <form>
      <input type="email" name="email" placeholder="Your Email Adress" /><Knap
        variant="accent">Subscribe</Knap
      >
    </form>
  </section>
</div>
<style>
  .full-bleed {
    background-color: var(--color-neutrals-900);
  }
  #newsletter {
    margin-block: var(--section-block-spacing);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 15px;

    form {
      margin-top: 15px;
      display: flex;
      align-items: stretch;
      gap: 1rem;
    }
    .Gulogstor {
      text-transform: uppercase;
      color: var(--color-action);
    }
    b {
      color: var(--color-action);
    }

    p,
    h1 {
      color: var(--color-neutrals-50);
    }
    input {
      border-radius: 20px;
      padding: 15px;
      border: white 1px solid;
      background-color: #000;
      &::placeholder {
        color: var(--color-text-weak);
      }
    }
  }
  @media (max-width: 400px) {
    #newsletter {
      text-align: center;
    }
  }
</style>
