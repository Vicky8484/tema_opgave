---
//@ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;

      & > article {
        /* flex: 250px; */
      }
    }
  }
</style>
