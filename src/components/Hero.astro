---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "@components/Button.astro";
---

<section class="hero full-bleed">
  <div class="hero-content">
    <div class="inner-content">
      <h1><span class="gul-linje">Empowering</span> Your Business Growth</h1>
      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>
      <br />
      <div class="button-box">
        <Button variant="accent" href="#0">Book a Meeting</Button>
        <Button variant="border" href="#0">Learn More</Button>
      </div>
    </div>
  </div>

  <Image class="hero-image" src={CEOImage} alt="CEO" />

  <div class="services-grid-item">
    <Services />
  </div>
</section>

<style>
  /* Styles her */
  .hero {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: full-start / full-end;

    grid-template-rows:
      [hero-start] 3fr
      [rohe-start] 1fr
      [hero-end] 1fr
      [rohe-end];

    .hero-content {
      background-color: var(--color-ui-primary);
      color: var(--color-surface-primary);

      grid-template-columns: subgrid;
      grid-column: full-start / center;
      display: grid;
      grid-row: hero-start / hero-end;

      button {
        background: var(--color-surface-primary);
        border: none;
        border-radius: 30px;
        padding-inline: 1.5rem;
        padding-block: 0.5rem;
      }

      .inner-content {
        grid-column: content-start / center;
        grid-row: hero-start / rohe-start;
        align-items: center;
        width: 60%;
        margin-bottom: 3rem;

        > button:first-child {
          margin-right: 1rem;
        }

        .button-box {
          display: flex;
          gap: 1rem;
        }
      }
    }

    .hero-image {
      grid-column: center / full-end;
      grid-row: hero-start / hero-end;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .services-grid-item {
      grid-column: content-start / content-end;
      grid-row: rohe-start / rohe-end;
    }
  }
</style>
