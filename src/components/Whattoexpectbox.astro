---
import { Image } from 'astro:assets';
import folk from '../data/images/folkdersnakkeigruppe.jpg';
//@ts-nocheck
import Checkmark from '../icons/checkmark.svg'; 
---

<section class="whattoexpect-layout">
<figure>
<Image src= {folk} alt="Menesker der snakke sammen i en gruppe"/>
</figure>
<div>
<h2>What To Expect</h2>
<p>
    Our collaboration is built on transparency,
     efficiency, and measurable results.
      Together, we create strategies tailored to your unique needs and goals.
</p>
    <ul>
        <li><Checkmark style=" var(--color-ui-secondary)"/>Collaborate to build actionable strategies that drive sustainable growth and deliver tangible outcomes.</li>
         <li><Checkmark style=" var(--color-ui-secondary))"/>Identify opportunities to optimize processes and implement impactful solutions with measurable results.</li>
    </ul>
      </div>
      </section>



      
  <style>

.whattoexpect-layout {
        display: grid;
 grid-template-columns: 1fr 2fr ;
 grid-column: content;
gap: 1rem;
padding: 15px;
      display: inline flex;
  flex-flow: wrap; 
  gap: 1rem;
  > * {
    flex: 300px;
  }
}
ul{
  list-style-type: none;
}


  figure {
  margin-inline: auto;
  max-inline-size: 300px;
  margin: 3rem 1rem;
  display: block;

 img{
    border-radius: 15px; 
  }
  


/**til start med^^ */

  position: relative;
  isolation: isolate; 
  
  &::before{
    content: "";
    position: absolute;
    top: -1rem;
    left: -1rem; 
    height: 100px;
    width: 100px;
    background: var(--color-ui-secondary);
    z-index: -1; 
    border-radius: 15px;
  }
}
</style>
