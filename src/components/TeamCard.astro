---
const { slug, name, title, description, image } = Astro.props;
import Insta from "@icons/instagram.svg";
import Face from "@icons/facebook.svg";
---

<a href={`/team/${slug}`} class="member-wrapper">
  <article>
    <img
      src={image?.src}
      alt={image?.alt || `Portræt af ${name}`}
      width={image?.width}
      height={image?.height}
      loading="lazy"
    />
    <div class="article-content">
      <h2>{name}</h2>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="btnbox">
        <Insta class="svg" />
        <Face class="svg" />
      </div>
    </div>
  </article>
</a>

<style>
  .member-wrapper {
    container: member / inline-size;
  }

  article {
    display: grid;
    gap: 10px;
    border-radius: 19px;
    box-shadow: 2px 2px 4px #0000004c;
    text-align: center;

    img {
      border-radius: 19px;
      padding: 0;
      place-self: stretch;
      object-fit: cover;
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    .btnbox {
      display: flex;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      justify-content: center;
      gap: 1rem;
    }

    @container member (width > 350px) {
      grid-template-columns: 1fr 3fr;

      .btnbox {
        display: none;
        background: green;
      }

      img {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom-left-radius: 19px;
        place-self: stretch;
        object-fit: cover;
      }
    }

    & div {
      padding: 5px;
    }
  }

  .article-content {
    padding: 1rem;
  }
</style>
