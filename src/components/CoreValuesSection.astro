---
//@ts-nocheck
import ValueCard from "@components/ValueCard.astro";
const response = await fetch("https://ftk-api.pages.dev/core-values");
const { title, subtitle, eyebrow, values: valuesData } = await response.json();
const { theme = "default" } = Astro.props;
import Tekst from "@components/Tekst.astro";
import Button from "@components/Button.astro";
---

<section class="coreValues full-bleed" data-theme={theme}>
  <div class="textnbtn">
    <Tekst
      title="Our core values & principles"
      subtitle="Capitalize on low hanging fruit to identify a ballpark value added activity beta test. Override the digital divide with additional from DevOps."
      eyebrow="Growing with our Clients"
    />

    <Button variant="dark">Join our team</Button>
  </div>
  <section class="valueCardBox">
    {valuesData.map((value) => <ValueCard value={value} />)}
  </section>
</section>

<style>
  .coreValues {
    --card-bg: var(--color-surface-tertiary);
    --card-color: var(--color-text);

    background-color: var(--color-ui-primary);
    color: white;
    padding-block: 3rem;

    .valueCardBox {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .svg {
      width: 40px;
      height: 40px;
      padding: 8px;
      border-radius: 100%;
    }
  }

  .coreValues[data-theme="dark"] {
    --card-bg: contrast-color(var(--color-ui-primary));
    --card-color: var(--color-ui-primary);
  }

  .coreValues[data-theme="light"] {
    --card-bg: var(--color-ui-primary);
    --card-color: contrast-color(var(--color-ui-primary));
  }

  [data-theme="dark"] {
    background-color: var(--color-ui-primary);
    color: contrast-color(var(--color-ui-primary));

    .svg {
      background-color: var(--color-ui-primary);
      color: contrast-color(var(--color-ui-primary));
    }
  }

  [data-theme="light"] {
    background-color: contrast-color(var(--color-ui-primary));
    color: var(--color-ui-primary);

    .svg {
      color: var(--color-ui-primary);
      background: contrast-color(var(--color-ui-primary));
    }
  }

  .textnbtn {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: 1rem;
  }

  button {
    justify-self: end;
    width: max-content;
    white-space: nowrap;
  }
</style>
