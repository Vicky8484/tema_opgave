---
//@ts-nocheck
import ScrollCard from "@components/ScrollCard.astro";
import Button from "@components/Button.astro";
import ArrowRight from "@icons/arrow--right.svg";
import ArrowLeft from "@icons/arrow-left.svg";

const response = await fetch("https://ftk-api.pages.dev/financial-projections");
const { title, subtitle, eyebrow, values: scrollData } = await response.json();
import Tekst from "@components/Tekst.astro";
---

<section id="financialProjectionsSection" class="full-bleed">
  <div class="textnbtn">
    <Tekst
      title="Financial Projections"
      subtitle="Financial projections are essential for planning and monitoring a company’s performance. They provide insights into potential revenue, expenses, and profitability over specific periods."
      eyebrow="Financial Tools"
    />

    <div>
      <Button variant="dark" id="scroll-left" aria-label="Scroll left"
        ><ArrowLeft /></Button
      >
      <Button variant="dark" id="scroll-right" aria-label="Scroll right"
        ><ArrowRight /></Button
      >
    </div>
  </div>

  <section class="scroll">
    <div class="scrollBox">
      {scrollData.map((scroll) => <ScrollCard scroll={scroll} />)}
    </div>
  </section>
</section>

<style>
  #financialProjectionsSection {
    padding-block: var(--section-block-spacing);
    min-width: 0;
    background: var(--color-neutrals-100);
  }

  .scroll {
    grid-column: content-start / full-end;
    display: grid;
    grid-template-columns: subgrid;
    min-width: 0;
    overflow-inline: auto;
    overflow-y: hidden;
    scroll-snap-type: inline mandatory;
    margin-right: var(--space-s);

    .scrollBox {
      display: flex;
      flex-wrap: nowrap;
      width: max-content;
      gap: var(--space-s);
      padding-inline: 0;
      gap: var(--space-s);
      padding-block: var(--space-s);
    }
  }

  @supports selector(::-webkit-scrollbar) {
    .scroll {
      &::-webkit-scrollbar {
        height: 10px;
      }

      &::-webkit-scrollbar-track {
        background: transparent;
      }

      &::-webkit-scrollbar-thumb {
        background: var(--color-ui-primary);
        border-radius: var(--roundedSmall);
      }
    }
  }

  @supports not selector(::-webkit-scrollbar) {
    .scroll {
      /* Fallback til browsere uden WebKit-scrollbar-selectoren */
      scrollbar-width: 10px;
      scrollbar-color: var(--color-ui-primary) transparent;
    }
  }

  .textnbtn {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-s);

    > div {
      justify-self: end;
      width: max-content;
      white-space: nowrap;
      display: flex;
      gap: var(--space-s);

      button {
        border-radius: 100%;
      }
    }
  }

  @media (max-width: 800px) {
    .textnbtn {
      grid-template-columns: 1fr;

      > div {
        justify-self: start;
        width: max-content;
        display: flex;
        gap: var(--space-s);
      }
    }
  }
</style>

<script>
  const scrollBox = document.querySelector<HTMLElement>(
    "#financialProjectionsSection .scroll",
  );
  const leftButton = document.querySelector<HTMLButtonElement>("#scroll-left");
  const rightButton =
    document.querySelector<HTMLButtonElement>("#scroll-right");

  if (scrollBox && leftButton && rightButton) {
    leftButton.addEventListener("click", () => {
      scrollBox.scrollBy({
        left: -scrollBox.clientWidth,
        behavior: "smooth",
      });
    });

    rightButton.addEventListener("click", () => {
      scrollBox.scrollBy({
        left: scrollBox.clientWidth,
        behavior: "smooth",
      });
    });
  }
</script>
