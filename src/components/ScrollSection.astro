---
//@ts-nocheck
import ScrollCard from "@components/ScrollCard.astro";

const response = await fetch("https://ftk-api.pages.dev/financial-projections");
const { title, subtitle, eyebrow, values: scrollData } = await response.json();
---

<section id="financialProjectionsSection" class="full-bleed">
  <p>{eyebrow}</p>
  <br />
  <h1>{title}</h1>
  <br />
  <h3>{subtitle}</h3>

  <section class="scroll">
    <div class="scrollBox">
      {scrollData.map((scroll) => <ScrollCard scroll={scroll} />)}
    </div>
  </section>
</section>

<style>
  #financialProjectionsSection {
    padding-block: 3rem;
    min-width: 0;
    background: #f9fafd;

    h1 {
      font-size: 2rem;
    }
  }

  .scroll {
    color: white;
    grid-column: full-start / full-end;
    display: grid;
    grid-template-columns: subgrid;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: inline mandatory;

    .scrollBox {
      grid-column: full-start / full-end;
      display: flex;
      flex-wrap: nowrap;
      width: max-content;
      gap: 1rem;
      padding-inline: 0;
      scroll-padding-inline: 1rem;
      /* overflow-inline: auto; */
      gap: 1rem;
      padding-block: 1rem;
    }
  }
</style>
