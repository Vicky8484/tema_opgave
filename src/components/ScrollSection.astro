---
//@ts-nocheck
import ScrollCard from "@components/ScrollCard.astro";

// const scrollData = await fetch(
//   "https://ftk-api.pages.dev/financial-projections",
// ).then((res) => res.json());

const response = await fetch("https://ftk-api.pages.dev/financial-projections");
const { title, subtitle, eyebrow, values: scrollData } = await response.json();
---

<section id="financialProjectionsSection">
  <p>{eyebrow}</p>
  <br />
  <h1>{title}</h1>
  <br />
  <h3>{subtitle}</h3>

  <section class="scroll">
    <div class="scrollBox">
      {scrollData.map((scroll) => <ScrollCard scroll={scroll} />)}
    </div>
  </section>
</section>

<style>
  #financialProjectionsSection {
    padding-top: 3rem;
    min-width: 0;

    h1 {
      font-size: 2rem;
    }
  }

  .scroll {
    color: white;
    min-width: 0;
    max-width: 100%;

    .scrollBox {
      display: flex;
      flex-wrap: nowrap;
      min-width: 0;
      gap: 1rem;
      padding-inline: 1rem;
      scroll-padding-inline: 1rem;
      overflow-inline: auto;
      display: flex;
      scroll-snap-type: inline mandatory;
      gap: 1rem;
      padding-block: 1rem;
    }
  }
</style>
