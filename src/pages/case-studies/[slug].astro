---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import TitleHero from "@components/TitleHero.astro";
import Button from "@components/Button.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <main>
    <TitleHero />

    <article class="case-story-article">
      <header>
        <Image
          class="billede1"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
        />

        <div class="case-details">
          <dl>
            <div>
              <dt>Case Name</dt>
              <dd>{caseName}</dd>
            </div>
            <div>
              <dt>Category</dt>
              <dd class="category">{category}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd class="date">{date}</dd>
            </div>
          </dl>
          <Button variant="accent" href="#0" class="button"
            >{buttonLabel}</Button
          >
        </div>
      </header>

      <section class="case-story-content">
        {
          caseStudy.sections.map((section, index) => (
            <>
              {index === 0 ? (
                <h2>{section.title}</h2>
              ) : (
                <h3>{section.title}</h3>
              )}

              {Array.isArray(section.content) ? (
                <>
                  {section.content.map((item) => (
                    <p>{item}</p>
                  ))}
                </>
              ) : (
                <p>{section.content}</p>
              )}
              {section.highlights && (
                <ul>
                  {section.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
              {section.image && (
                <figure>
                  <Image
                    class="billede2"
                    src={section.image.src}
                    alt={section.image.alt}
                    width={section.image.width}
                    height={section.image.height}
                  />
                  {section.image.caption && (
                    <figcaption>
                      <p>{section.image.caption}</p>
                    </figcaption>
                  )}
                </figure>
              )}
            </>
          ))
        }
      </section>
    </article>
  </main>
</Layout>

<style>
  article {
    margin-block: var(--section-block-spacing);
  }
  header {
    grid-template-rows:
      [hero-start] 3fr
      [rohe-start] 50px
      [hero-end] 50px
      [rohe-end];
  }

  .case-details {
    background: black;
    color: white;
    display: flex;
    justify-content: space-between;
    grid-column: b-start/b-end;
    border-radius: 30px;
    padding-block: 30px;
    padding-inline: 2rem;
    grid-row: rohe-start / rohe-end;
    align-items: center;

    dl {
      gap: 4rem;
      display: flex;
      justify-content: space-between;

      dt {
        font-weight: bold;
      }
    }
  }

  .billede1 {
    border-radius: 30px;
    grid-row: hero-start / hero-end;
  }

  /*GRID LOGIK*/
  .case-story-article {
    display: grid;
    grid-template-columns:
      [a-start] 2fr
      [b-start] 1fr
      [c-start] minmax(0, 1000px) [c-end]
      1fr [b-end]
      2fr [a-end];
  }

  .case-story-article > header,
  .case-story-content {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: a-start / a-end;
  }

  .billede1,
  .case-details {
    grid-column: a-start / a-end;
  }

  .case-details {
    grid-column: b-start / b-end;
  }

  .case-story-content > * {
    grid-column: c-start / c-end;
  }

  .case-story-content figure {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: a-start / a-end;
    margin-inline: 0;
  }

  .billede2 {
    grid-column: a-start / a-end;
    width: 100%;
  }

  .case-story-content figure .billede2,
  .case-story-content figure figcaption {
    grid-row: 1;
  }

  .case-story-content figure figcaption {
    display: grid;
    grid-column: a-start / a-end;
    align-self: end;
    padding: 1rem;
    color: white;
    background: linear-gradient(rgba(0, 0, 0, 0) 10%, rgb(0 0 0 / 60%) 90%);
    z-index: 1;
  }

  figcaption p {
    grid-column: c-start / c-end;
  }

  /**tekst styling **/
  section {
    --flow-space: 1em;
    --text-strong: oklch(0.18 0 0);
    --text: oklch(0.26 0 0);
    --text-muted: oklch(0.48 0 0);

    padding: var(--space-l, 2rem) var(--space-m, 1rem);

    font-size: var(--step-0);
    padding: var(--space-l) var(--space-m);

    & :is(h1, h2, h3, h4) {
      color: var(--text-strong);
      font-weight: bold;
    }

    & p + :is(h2, h3) {
      margin-block-start: 2em;
    }

    & :is(h2, h3) + :is(h3, h4) {
      margin-block-start: 0.35em;
    }

    h1 {
      font-size: var(--step-2);
    }

    p {
      font-size: var(--step--1);
    }
  }
</style>
