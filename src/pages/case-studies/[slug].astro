---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import TitleHero from "@components/TitleHero.astro";
import Button from "@components/Button.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
   <TitleHero />
  <main>
   

    <article class="case-story-article">
      <header>
        <Image
          class="billede1"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
        />

        <div class="case-details-container">
          <div class="case-details">
            <dl>
              <div>
                <dt>Case Name</dt>
                <dd>{caseName}</dd>
              </div>
              <div>
                <dt>Category</dt>
                <dd class="category">{category}</dd>
              </div>
              <div>
                <dt>Date</dt>
                <dd class="date">{date}</dd>
              </div>
            </dl>
            <Button variant="accent" href="#0" class="button"
              >{buttonLabel}</Button
            >
          </div>
        </div>
      </header>

      <section class="case-story-content">
        {
          caseStudy.sections.map((section, index) => (
            <>
              {index === 0 ? (
                <h2>{section.title}</h2>
              ) : (
                <h3>{section.title}</h3>
              )}

              {Array.isArray(section.content) ? (
                <>
                  {section.content.map((item) => (
                    <p>{item}</p>
                  ))}
                </>
              ) : (
                <p>{section.content}</p>
              )}
              {section.highlights && (
                <ul>
                  {section.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
              {section.image && (
                <figure>
                  <Image
                    class="billede2"
                    src={section.image.src}
                    alt={section.image.alt}
                    width={section.image.width}
                    height={section.image.height}
                  />
                  {section.image.caption && (
                    <figcaption>
                      <p>{section.image.caption}</p>
                    </figcaption>
                  )}
                </figure>
              )}
            </>
          ))
        }
      </section>
    </article>
  </main>
</Layout>

<style>
  article {
    margin-block: var(--section-block-spacing);
  }

  .case-details-container {
    container: details / inline-size;
    grid-column: b-start / b-end;
    grid-row: rohe-start / rohe-end;
    min-width: 0;
  }

  /*GRID LOGIK*/
  .case-story-article {
    display: grid;
    grid-template-columns:
      [a-start] 2fr
      [b-start] 1fr
      [c-start] minmax(0, 1000px) [c-end]
      1fr [b-end]
      2fr [a-end];
  }

  header {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: a-start / a-end;
    grid-template-rows:
      [hero-start] 3fr
      [rohe-start] 50px
      [hero-end] auto
      [rohe-end];
  }

  .case-details {
    container: details / inline-size;
    background: var(--color-ui-primary);
    color: var(--color-surface-tertiary);
    border-radius: var(--stor-runding);
    padding-block: 30px;
    padding-inline: 2rem;
    align-items: center;

    display: grid;
    grid-template-columns: 1fr;
    grid-column: b-start/b-end;
    grid-row: rohe-start / rohe-end;

    dl {
      display: flex;
      flex-direction: column;
      justify-content: space-between;

      dt {
        font-weight: bold;
        color: var(--color-on-surface-elevated);
      }
    }

    button {
    }
  }

  @container details (min-width: 530px) {
    .case-details {
      grid-template-columns: 3fr 1fr;
    }

    .case-details dl {
      flex-direction: row;
    }
  }

  .billede1 {
    border-radius: 30px;
    grid-row: hero-start / hero-end;
  }

  .case-story-article > header,
  .case-story-content {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: a-start / a-end;
  }

  .billede1,
  .case-details {
    grid-column: a-start / a-end;
  }

  .case-details {
    grid-column: b-start / b-end;
  }

  .case-story-content > * {
    grid-column: c-start / c-end;
  }

  .case-story-content figure {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: a-start / a-end;
    margin-inline: 0;
  }

  .billede2 {
    grid-column: a-start / a-end;
    width: 100%;
  }

  .case-story-content figure .billede2,
  .case-story-content figure figcaption {
    grid-row: 1;
  }

  .case-story-content figure figcaption {
    display: grid;
    grid-column: a-start / a-end;
    align-self: end;
    padding: 1rem;
    background: linear-gradient(rgba(0, 0, 0, 0) 10%, rgb(0 0 0 / 60%) 90%);
    z-index: 1;
  }

  figcaption p {
    grid-column: c-start / c-end;
  }

  /**tekst styling **/
  section {
    p,
    li {
      color: var(--text-muted);
    }

    figcaption p {
      color: contrast-color(var(--text-strong));
    }
  }
</style>
