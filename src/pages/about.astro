---
import Layout from "@layouts/Layout.astro";
import TitleHero from "@components/TitleHero.astro";
import OurVision from "@components/OurVisionSection.astro";
import CoreValues from "@components/CoreValuesSection.astro";
import OurTeam from "@components/OurTeamSection.astro";
import FAQ from "@components/FAQSection.astro";

const response = await fetch("https://ftk-api.pages.dev/team");
if (!response.ok) throw new Error("Kunne ikke hente teamdata");
const members = await response.json();
---

<Layout>
  <main>
    <TitleHero />
    <OurVision />
    <CoreValues theme="light" />
    <OurTeam members={members} />
    <FAQ />
  </main>
</Layout>
